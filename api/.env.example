# Runtime profile used by the Spring Boot container.
SPRING_PROFILES_ACTIVE=docker

# Production-only metadata passed by docker-compose.prod.yml.
ENVIRONMENT=production

# Comma-separated browser origins allowed to call the API and WebSocket endpoint.
FRONTEND_ORIGIN=https://mlp.example.com

# Optional training session tuning.
MLP_TRAINING_CREATED_SESSION_TTL_MS=120000
MLP_TRAINING_MAX_RUNNING_DURATION_MS=600000
MLP_TRAINING_TERMINAL_SESSION_TTL_MS=600000
MLP_TRAINING_SESSION_CLEANUP_INTERVAL_MS=30000
MLP_TRAINING_MAX_SESSIONS=50
