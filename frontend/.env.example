# Public domain served by Traefik in production.
FRONTEND_ALLOWED_HOSTS=mlp.example.com

# Public API origin used by production builds if frontend code reads Vite env.
VITE_API_BASE_URL=https://api.mlp.example.com

# Development-only Vite settings.
VITE_API_PROXY_TARGET=http://api:8080
VITE_USE_POLLING=true
