# Used by docker-compose.prod.yml for Traefik routing.
APP_DOMAIN=mlp.example.com
API_DOMAIN=api.mlp.example.com

# Must match the browser origin that is allowed to call the API.
FRONTEND_ORIGIN=https://mlp.example.com

# Optional. Defaults to lets-encrypt when omitted.
TRAEFIK_CERT_RESOLVER=lets-encrypt

# Optional. Defaults to traefik_proxy when omitted.
TRAEFIK_NETWORK=traefik_proxy
